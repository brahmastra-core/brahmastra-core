# Lightweight Python runtime for Node-A (<100MB)
FROM python:3.11-slim-bullseye AS base

# Hardened Non-Root User Configuration (UID: 10001)
RUN groupadd -g 10001 brahmastra_group && \
    useradd -u 10001 -g brahmastra_group -m -s /bin/bash brahmastra_user

WORKDIR /app

# Copy entrypoint script and assign unprivileged ownership
COPY entrypoint.py /app/entrypoint.py
RUN chown -R brahmastra_user:brahmastra_group /app

USER brahmastra_user

ENV NODE_ID="Node-A" \
    NODE_IP="172.28.0.10" \
    LISTEN_PORT=443 \
    PYTHONUNBUFFERED=1

EXPOSE 443

CMD ["python3", "/app/entrypoint.py"]