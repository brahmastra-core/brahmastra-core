import hashlib
import time

print("--- బ్రహ్మాస్త్రం: 80% ధర్మ అల్గారిథమ్ ఇంజిన్ ---\n")

class DharmaContract:
    def __init__(self):
        # 80% ధర్మ ఫండ్ వాలెట్ (వైద్యం & విద్య కోసం లాక్ చేయబడిన రిజర్వ్)
        self.dharma_fund = 0.0
        # 20% నెట్‌వర్క్ నిర్వహణ వాలెట్ (నోడ్ రన్నర్స్ & ఇన్‌ఫ్రాస్ట్రక్చర్)
        self.infra_fund = 0.0
        self.ledger = []

    def process_transaction(self, tx_id, amount):
        # 80% ధర్మ నియమం - మార్చడానికి వీల్లేని కోడ్ రూల్
        dharma_share = amount * 0.80
        infra_share = amount * 0.20

        self.dharma_fund += dharma_share
        self.infra_fund += infra_share

        # బ్లాక్‌చెయిన్ తరహా లెడ్జర్ ఎంట్రీ (క్రిప్టోగ్రాఫిక్ రికార్డ్)
        entry = {
            "tx_id": tx_id,
            "total_fee": amount,
            "dharma_share": dharma_share,
            "infra_share": infra_share,
            "hash": hashlib.sha256(f"{tx_id}{amount}{time.time()}".encode()).hexdigest()[:16]
        }
        self.ledger.append(entry)
        print(f"లావాదేవీ: {tx_id} | మొత్తం ఫీజు: {amount} Credits")
        print(f" -> ధర్మ పూల్‌కు వెళ్లినది (80%): {dharma_share:.2f} Credits (పేదల వైద్యం/విద్య)")
        print(f" -> ఇన్‌ఫ్రాకు వెళ్లినది (20%): {infra_share:.2f} Credits (నెట్‌వర్క్ నిర్వహణ)")
        print(f" -> లెడ్జర్ హాష్: {entry['hash']}\n")

# సిమ్యులేషన్ ప్రారంభం
brahmastra_node = DharmaContract()

# నెట్‌వర్క్‌లో 3 వరుస లావాదేవీల నమూనా
transactions = [
    ("TX_1001", 100.0),
    ("TX_1002", 250.0),
    ("TX_1003", 500.0)
]

for tx_id, fee in transactions:
    brahmastra_node.process_transaction(tx_id, fee)

print("=" * 45)
print(f"బ్రహ్మాస్త్రం ధర్మ రిజర్వ్ నిధులు (80%): {brahmastra_node.dharma_fund:.2f} Credits")
print(f"నెట్‌వర్క్ నిర్వహణ నిధులు (20%): {brahmastra_node.infra_fund:.2f} Credits")
print("ధర్మ సూత్రం ధ్రువీకరించబడింది: కోడ్ అనేది చట్టం (Code is Law)!")
print("=" * 45)