import hashlib
import time

print("--- Brahmastra: 80% Dharma Algorithm Engine ---\n")

class DharmaContract:
    def __init__(self):
        # 80% Dharma Fund Wallet (Locked reserve for healthcare & education)
        self.dharma_fund = 0.0
        # 20% Network Maintenance Wallet (Node rewards & infrastructure)
        self.infra_fund = 0.0
        self.ledger = []

    def process_transaction(self, tx_id, amount):
        # 80% Dharma Rule - Immutable Code Law
        dharma_share = amount * 0.80
        infra_share = amount * 0.20

        self.dharma_fund += dharma_share
        self.infra_fund += infra_share

        # Blockchain Ledger Entry (Cryptographic Record)
        entry = {
            "tx_id": tx_id,
            "total_fee": amount,
            "dharma_share": dharma_share,
            "infra_share": infra_share,
            "hash": hashlib.sha256(f"{tx_id}{amount}{time.time()}".encode()).hexdigest()[:16]
        }
        self.ledger.append(entry)
        print(f"Transaction: {tx_id} | Total Fee: {amount} Credits")
        print(f" -> Allocated to Dharma Pool (80%): {dharma_share:.2f} Credits (Healthcare/Education)")
        print(f" -> Allocated to Infra Pool (20%): {infra_share:.2f} Credits (Network Operations)")
        print(f" -> Ledger Hash: {entry['hash']}\n")


# Simulation Start
brahmastra_node = DharmaContract()

# Sample sequential transactions on network
transactions = [
    ("TX_1001", 100.0),
    ("TX_1002", 250.0),
    ("TX_1003", 500.0)
]

for tx_id, fee in transactions:
    brahmastra_node.process_transaction(tx_id, fee)

print("-" * 45)
print(f"Brahmastra Dharma Reserve Funds (80%): {brahmastra_node.dharma_fund:.2f} Credits")
print(f"Network Operations Funds (20%): {brahmastra_node.infra_fund:.2f} Credits")
print("Dharma Protocol Verified: Code is Law")
print("-" * 45)
